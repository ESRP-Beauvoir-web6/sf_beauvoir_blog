{% extends 'base.html.twig' %}

{% block title %}Post{% endblock %}

{% block body %}
    <h1>Post</h1>

    <div class="card">
        <h2>{{ post.title }}</h2>
        <p>{{ post.content }}</p>
        <p>Ecrit par {{ post.author.username }} le {{ post.createdAt ? post.createdAt|date('d/m/Y H:i') : '' }}</p>
    </div>

    <a href="{{ path('app_post_index') }}">Retour aux articles</a>
    {% if is_granted("ROLE_ADMIN") %}
    <a href="{{ path('app_post_edit', {'id': post.id}) }}">Modifier l'article</a>
    {% endif %}
    <a href="{{ path('app_comment_new', {'id' : post.id}) }}">Laisser un commentaire</a>

    <div>
        <h2>Liste des commentaires ({{ post.comments|length }})</h2>
        {% for comment in post.comments %}
        <div>
            <p>{{ comment.content }}</p>
            <p>Écrit par {{ comment.author.username }}</p>
        </div>
        {% endfor %}
    </div>

    {{ include('post/_delete_form.html.twig') }}
{% endblock %}
