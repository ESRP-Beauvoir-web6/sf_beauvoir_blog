{% extends 'base.html.twig' %}

{% block title %}Post index{% endblock %}

{% block body %}
    <h1 class="text-center text-4xl mt-5 mb-5">Liste des articles</h1>

    

    <div class="relative overflow-x-auto bg-neutral-primary-soft shadow-xs rounded-base border border-default w-1/2 m-auto">
        <table class="w-full text-sm text-left rtl:text-right text-body">
            <thead class="bg-neutral-secondary-soft border-b border-default">
                <tr>
                    <th scope="col" class="px-6 py-3 font-medium">
                        Titre de l'article
                    </th>
                    <th scope="col" class="px-6 py-3 font-medium">
                        Catégories
                    </th>
                    <th scope="col" class="px-6 py-3 font-medium">
                        Actions
                    </th>
                </tr>
            </thead>
            <tbody>
                {% for post in posts %}
                <tr class="odd:bg-neutral-primary even:bg-neutral-secondary-soft border-b border-default">
                    <th scope="row" class="px-6 py-4 font-medium text-heading whitespace-nowrap">
                        {{ post.title }}
                    </th>
                    <td class="px-6 py-4">
                        {% for category in post.category %}<p class="bg-brand-softer text-fg-brand-strong text-xs font-medium px-1.5 py-0.5 rounded mb-5">{{ category.name }}</p>{% endfor %}
                    </td>
                    <td class="px-6 py-4">
                        <a class="text-white bg-success box-border border border-transparent hover:bg-success-strong focus:ring-4 focus:ring-success-medium shadow-xs font-medium leading-5 rounded-base text-sm px-4 py-2.5 focus:outline-none" href="{{ path('app_post_show', {'id': post.id}) }}">Voir l'article</a>
                        {% if is_granted("ROLE_ADMIN") %}
                        <a class="text-white bg-warning box-border border border-transparent hover:bg-warning-strong focus:ring-4 focus:ring-warning-medium shadow-xs font-medium leading-5 rounded-base text-sm px-4 py-2.5 focus:outline-none" href="{{ path('app_post_edit', {'id': post.id}) }}">Modifier un article</a>
                        {% endif %}
                    </td>
                    {% else %}
                        <tr>
                            <td class="px-6 py-4" colspan="5">Pas d'articles</td>
                        </tr>
                    {% endfor %}
                </tr>
            </tbody>
        </table>
    </div>

    <a href="{{ path('app_post_new') }}">Create new</a>
{% endblock %}
