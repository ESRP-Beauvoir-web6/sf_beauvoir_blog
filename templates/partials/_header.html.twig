<header>
    <div>
        <h1>Beauvoir Blog</h1>
    </div>
    <nav>
        <ul>
            {% if not app.user %}
            <li><a href="{{ path("app_login") }}">Connexion</a></li>
            <li><a href="{{ path("app_register") }}">Inscription</a></li>
            
            {% else %}
            <li><a href="{{ path("app_logout") }}">Deconnexion</a></li>
            <li>Bonjour {{ app.user.username }}</li>
            {% endif %}
            {% if is_granted('ROLE_ADMIN') %} 
            <li><a href="{{ path('app_user_index') }}">Menu admin</a></li>
            {% endif %}    
        </ul>
    </nav>
</header>