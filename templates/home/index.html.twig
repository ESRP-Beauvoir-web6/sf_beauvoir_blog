{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}

<main class="min-h-screen bg-slate-50 text-slate-900">

    <!-- HERO -->
    <section class="bg-slate-950 text-white">
        <div class="max-w-7xl mx-auto px-6 py-20 lg:py-28">
            <div class="max-w-3xl">
                <span class="inline-block mb-6 rounded-full border border-violet-400/30 bg-violet-500/10 px-4 py-2 text-sm font-medium text-violet-300">
                    Bienvenue sur notre blog
                </span>

                <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight leading-tight">
                    Des idées, des histoires
                    <span class="text-violet-400">et de l'inspiration.</span>
                </h1>

                <p class="mt-6 text-lg text-slate-400 leading-relaxed">
                    Explorez nos articles, découvrez de nouvelles perspectives
                    et partagez notre passion pour le numérique, la créativité
                    et les nouvelles technologies.
                </p>

                <a href="#articles"
                   class="inline-flex mt-8 items-center gap-2 rounded-xl bg-violet-600 px-6 py-3 font-semibold hover:bg-violet-500 transition">
                    Explorer les articles
                    <span aria-hidden="true">&rarr;</span>
                </a>
            </div>
        </div>
    </section>

    <!-- CONTENU PRINCIPAL -->
    <div class="max-w-7xl mx-auto px-6 py-16">

        <!-- ARTICLE À LA UNE -->
        <section class="mb-20">
            <div class="flex items-center justify-between mb-8">
                <h2 class="text-3xl font-bold">À la une</h2>
                <span class="text-sm text-slate-500">Notre sélection</span>
            </div>

            <article class="grid lg:grid-cols-2 overflow-hidden rounded-3xl bg-white shadow-sm border border-slate-200">

                <div class="h-72 lg:h-full">
                    <img
                        src="https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=1200&q=80"
                        alt="Espace de travail numérique"
                        class="w-full h-full object-cover"
                    >
                </div>

                <div class="p-8 lg:p-12 flex flex-col justify-center">
                    <span class="text-violet-600 font-semibold text-sm uppercase tracking-wide">
                        Technologie
                    </span>

                    <h3 class="mt-4 text-3xl font-bold leading-tight">
                        Comment les nouvelles technologies transforment notre quotidien
                    </h3>

                    <p class="mt-5 text-slate-600 leading-relaxed">
                        Intelligence artificielle, développement web et innovation :
                        découvrez les tendances qui façonnent notre avenir.
                    </p>

                    <div class="flex items-center gap-3 mt-6 text-sm text-slate-500">
                        <span>28 octobre 2026</span>
                        <span>•</span>
                        <span>5 min de lecture</span>
                    </div>

                    <a href="#"
                       class="mt-8 inline-flex items-center gap-2 text-violet-600 font-semibold hover:text-violet-800 transition">
                        Lire l'article
                        <span aria-hidden="true">&rarr;</span>
                    </a>
                </div>
            </article>
        </section>

        <!-- CATÉGORIES -->
        <section class="mb-16">
            <h2 class="text-2xl font-bold mb-6">Explorer les catégories</h2>

            <div class="flex flex-wrap gap-3">
                <a href="#" class="rounded-full bg-violet-600 text-white px-5 py-2 text-sm font-medium">
                    Tous les articles
                </a>
                <a href="#" class="rounded-full bg-white border border-slate-200 px-5 py-2 text-sm hover:bg-violet-50 hover:border-violet-300 transition">
                    Développement web
                </a>
                <a href="#" class="rounded-full bg-white border border-slate-200 px-5 py-2 text-sm hover:bg-violet-50 hover:border-violet-300 transition">
                    Intelligence artificielle
                </a>
                <a href="#" class="rounded-full bg-white border border-slate-200 px-5 py-2 text-sm hover:bg-violet-50 hover:border-violet-300 transition">
                    Cybersécurité
                </a>
                <a href="#" class="rounded-full bg-white border border-slate-200 px-5 py-2 text-sm hover:bg-violet-50 hover:border-violet-300 transition">
                    Actualités
                </a>
            </div>
        </section>

        <!-- ARTICLES RÉCENTS -->
        <section id="articles" class="mb-20">
            <div class="flex items-center justify-between mb-8">
                <div>
                    <h2 class="text-3xl font-bold">Derniers articles</h2>
                    <p class="text-slate-500 mt-2">
                        Nos dernières publications à découvrir.
                    </p>
                </div>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">

                <!-- ARTICLE 1 -->
                <article class="group bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
                    <div class="overflow-hidden h-52">
                        <img
                            src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=800&q=80"
                            alt="Développement web"
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        >
                    </div>

                    <div class="p-6">
                        <span class="text-xs font-semibold text-violet-600 uppercase">
                            Développement
                        </span>

                        <h3 class="mt-3 text-xl font-bold group-hover:text-violet-600 transition">
                            Les bonnes pratiques pour devenir développeur web
                        </h3>

                        <p class="mt-3 text-slate-600 text-sm leading-relaxed">
                            Découvrez les compétences essentielles pour progresser
                            dans le développement web moderne.
                        </p>

                        <div class="flex justify-between items-center mt-6 pt-5 border-t border-slate-100">
                            <span class="text-xs text-slate-400">25 octobre 2026</span>
                            <a href="#" class="text-sm font-semibold text-violet-600 hover:text-violet-800">
                                Lire &rarr;
                            </a>
                        </div>
                    </div>
                </article>

                <!-- ARTICLE 2 -->
                <article class="group bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
                    <div class="overflow-hidden h-52">
                        <img
                            src="https://images.unsplash.com/photo-1677442136019-21780ecad995?auto=format&fit=crop&w=800&q=80"
                            alt="Intelligence artificielle"
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        >
                    </div>

                    <div class="p-6">
                        <span class="text-xs font-semibold text-violet-600 uppercase">
                            Intelligence artificielle
                        </span>

                        <h3 class="mt-3 text-xl font-bold group-hover:text-violet-600 transition">
                            L'intelligence artificielle et ses nouvelles possibilités
                        </h3>

                        <p class="mt-3 text-slate-600 text-sm leading-relaxed">
                            Comment l'IA révolutionne nos outils et notre façon
                            de travailler au quotidien.
                        </p>

                        <div class="flex justify-between items-center mt-6 pt-5 border-t border-slate-100">
                            <span class="text-xs text-slate-400">22 octobre 2026</span>
                            <a href="#" class="text-sm font-semibold text-violet-600 hover:text-violet-800">
                                Lire &rarr;
                            </a>
                        </div>
                    </div>
                </article>

                <!-- ARTICLE 3 -->
                <article class="group bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
                    <div class="overflow-hidden h-52">
                        <img
                            src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?auto=format&fit=crop&w=800&q=80"
                            alt="Cybersécurité"
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        >
                    </div>

                    <div class="p-6">
                        <span class="text-xs font-semibold text-violet-600 uppercase">
                            Cybersécurité
                        </span>

                        <h3 class="mt-3 text-xl font-bold group-hover:text-violet-600 transition">
                            Sécuriser efficacement ses applications web
                        </h3>

                        <p class="mt-3 text-slate-600 text-sm leading-relaxed">
                            Les fondamentaux de la sécurité pour protéger
                            vos projets et les données de vos utilisateurs.
                        </p>

                        <div class="flex justify-between items-center mt-6 pt-5 border-t border-slate-100">
                            <span class="text-xs text-slate-400">19 octobre 2026</span>
                            <a href="#" class="text-sm font-semibold text-violet-600 hover:text-violet-800">
                                Lire &rarr;
                            </a>
                        </div>
                    </div>
                </article>

            </div>

            <div class="text-center mt-12">
                <a href="#"
                   class="inline-flex items-center gap-2 border border-slate-300 rounded-xl px-7 py-3 font-semibold hover:bg-slate-900 hover:text-white transition">
                    Voir tous les articles
                    <span aria-hidden="true">&rarr;</span>
                </a>
            </div>
        </section>

        <!-- NEWSLETTER -->
        <section class="relative overflow-hidden rounded-3xl bg-violet-700 px-8 py-14 md:px-16 text-white">
            <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-violet-500/40 blur-3xl"></div>

            <div class="relative max-w-2xl mx-auto text-center">
                <h2 class="text-3xl md:text-4xl font-bold">
                    Ne manquez aucun article !
                </h2>

                <p class="mt-4 text-violet-100">
                    Recevez directement dans votre boîte mail nos dernières
                    publications et découvertes.
                </p>

                <form class="mt-8 flex flex-col sm:flex-row gap-3">
                    <input
                        type="email"
                        placeholder="Votre adresse e-mail"
                        aria-label="Votre adresse e-mail"
                        required
                        class="flex-1 min-w-0 rounded-xl bg-white px-5 py-3 text-slate-900 outline-none focus:ring-4 focus:ring-violet-300"
                    >
                    <button type="submit"
                            class="rounded-xl bg-slate-950 px-7 py-3 font-semibold hover:bg-slate-800 transition">
                        S'inscrire
                    </button>
                </form>
            </div>
        </section>

    </div>
</main>

{% endblock %}
